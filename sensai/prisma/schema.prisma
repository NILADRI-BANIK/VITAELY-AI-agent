generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  clerkUserId     String           @unique
  email           String           @unique @db.VarChar(255)
  name            String?
  imageUrl        String?
  industry        String?
  industryInsight IndustryInsight? @relation(fields: [industry], references: [industry])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  bio        String?
  experience Int?
  skills     String[]

  assessments      Assessment[]
  resumes          Resume[]
  coverLetter      CoverLetter[]
  conversions      ConversionRecord[]
  atsRecords       ATSRecord[]
  compressions     CompressionRecord[]
  emailRecords     EmailRecord[]
  portfolios       Portfolio[]
  projectIdeas     ProjectIdea[]
  savedProjects    SavedProject[]
  projectHistory   ProjectHistory[]
  favoriteProjects FavoriteProject[]
  projectExports   ProjectExport[]
  skillGapAnalyses SkillGapAnalysis[]
  skillProgress    SkillProgress[]
}

model Assessment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  quizScore      Float
  questions      Json[]
  category       String
  improvementTip String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Resume {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  title            String   @default("Untitled Resume")
  content          String   @db.Text
  formData         Json?
  profileImage     String?
  selectedTemplate String   @default("classic")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model CoverLetter {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  content        String
  jobDescription String?
  companyName    String
  jobTitle       String
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model IndustryInsight {
  id       String @id @default(cuid())
  industry String @unique

  users        User[]
  salaryRanges Json[]
  growthRate   Float
  demandLevel  DemandLevel
  topSkills    String[]

  marketOutlook     MarketOutlook
  keyTrends         String[]
  recommendedSkills String[]

  lastUpdated DateTime @default(now())
  nextUpdate  DateTime

  @@index([industry])
}

model ConversionRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fileName  String
  fileSize  Int
  status    String   @default("success")
  createdAt DateTime @default(now())

  @@index([userId])
}

model ATSRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  resumeId    String?
  resumeTitle String?
  atsScore    Float
  feedback    String   @db.Text
  suggestions String[]
  keywords    String[]
  createdAt   DateTime @default(now())

  @@index([userId])
}

model CompressionRecord {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  fileName         String
  originalSize     Int
  compressedSize   Int
  savedPercentage  Float
  compressionLevel String   @default("medium")
  status           String   @default("success")
  createdAt        DateTime @default(now())

  @@index([userId])
}

model EmailRecord {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  prompt         String            @db.Text
  tone           String
  length         String
  recipientName  String?
  companyName    String?
  jobRole        String?
  skills         String?
  signature      String?
  purpose        String
  generatedEmail String            @db.Text
  receiverEmail  String?
  attachments    EmailAttachment[]
  createdAt      DateTime          @default(now())

  @@index([userId])
}

model EmailAttachment {
  id            String      @id @default(cuid())
  emailRecordId String
  emailRecord   EmailRecord @relation(fields: [emailRecordId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  fileType      String?
  fileSize      Int?
  createdAt     DateTime    @default(now())

  @@index([emailRecordId])
}

model Portfolio {
  id               String  @id @default(cuid())
  userId           String
  user             User    @relation(fields: [userId], references: [id])
  title            String  @default("My Portfolio")
  slug             String? @unique
  templateId       String  @default("modern")
  theme            String  @default("dark")
  status           String  @default("draft")
  isPublic         Boolean @default(false)
  deployedUrl      String?
  thumbnail        String?
  parsedResumeData Json?

  // Personal Info
  fullName          String?
  professionalTitle String?
  summary           String? @db.Text
  profileImage      String?
  email             String?
  phone             String?
  address           String?

  // Social Links
  linkedin     String?
  github       String?
  twitter      String?
  portfolioUrl String?
  leetcode     String?
  hackerrank   String?
  codeforces   String?

  // Data stored as JSON arrays
  skills         Json?
  hobbies        Json?
  experience     Json?
  education      Json?
  projects       Json?
  certifications Json?
  achievements   Json?

  // Generated portfolio data
  generatedData Json?
  generatedCode String? @db.Text

  // Resume source
  resumeUrl      String?
  resumeFileName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ProjectIdea {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id])
  title                  String
  description            String   @db.Text
  techStack              Json
  features               String[]
  difficulty             String
  duration               String
  learningOutcomes       String[]
  roadmap                Json?
  resumeScore            Float?
  industryDemand         String?
  deploymentSuggestions  String[]
  databaseRecommendation String?
  apiRecommendations     String[]
  erDiagram              String?  @db.Text
  interviewQuestions     String[]
  githubStructure        String?  @db.Text
  readme                 String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  saved     SavedProject[]
  favorites FavoriteProject[]
  exports   ProjectExport[]

  @@index([userId])
}

model SavedProject {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  projectIdeaId String
  projectIdea   ProjectIdea @relation(fields: [projectIdeaId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([userId])
}

model ProjectHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  skills          String[]
  experienceLevel String
  domain          String
  complexity      String
  projectCount    Int
  generatedAt     DateTime @default(now())

  @@index([userId])
}

model FavoriteProject {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  projectIdeaId String
  projectIdea   ProjectIdea @relation(fields: [projectIdeaId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([userId])
}

model ProjectExport {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  projectIdeaId String
  projectIdea   ProjectIdea @relation(fields: [projectIdeaId], references: [id], onDelete: Cascade)
  format        String      @default("pdf")
  exportedAt    DateTime    @default(now())

  @@index([userId])
}

model SkillGapAnalysis {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  targetRole     String
  experience     String
  currentSkills  String[]
  matchScore     Int
  missingSkills  String[]
  prioritySkills Json
  roadmap        Json
  courses        Json
  projects       Json
  timeline       String
  createdAt      DateTime        @default(now())
  progress       SkillProgress[]

  @@index([userId])
}

model SkillProgress {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  analysisId  String
  analysis    SkillGapAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  skillName   String
  completed   Boolean          @default(false)
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@index([analysisId])
}

enum DemandLevel {
  HIGH
  MEDIUM
  LOW
}

enum MarketOutlook {
  POSITIVE
  NEUTRAL
  NEGATIVE
}
